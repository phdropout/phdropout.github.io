---
import Breadcrumb from '../components/Breadcrumb.astro';
import { SITE_NAME, subjects, type SubjectId, type Topic } from '../data/site';
import BaseLayout from './BaseLayout.astro';

interface Props {
  subject: SubjectId;
}

const { subject } = Astro.props;
const { label } = subjects[subject];
const topics: Topic[] = subjects[subject].topics;
---

<BaseLayout title={`${label} — ${SITE_NAME}`} activeSubject={subject}>
  <Breadcrumb items={[{ label }]} />

  <section class="page-header">
    <h1>{label}</h1>
    <p class="page-subtitle">Select a topic to explore</p>
  </section>

  <ul class="topic-list">
    {topics.map((topic) => (
      <li>
        <a id={topic.id} class="topic-row" href={topic.href}>
          <span class="topic-text">
            <span class="topic-title">{topic.title}</span>
            <span class="topic-summary">{topic.summary}</span>
          </span>
          <span class="topic-arrow" aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>

  <slot />
</BaseLayout>
