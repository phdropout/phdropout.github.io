---
import Breadcrumb from '../components/Breadcrumb.astro';
import MathJax from '../components/MathJax.astro';
import { SITE_NAME, sections, type Article, type SectionId } from '../data/site';
import BaseLayout from './BaseLayout.astro';

interface TocEntry {
  /** Id of the part of the article to jump to, without the leading "#". */
  id: string;
  label: string;
}

interface Props {
  section: SectionId;
  /** The article's id in src/data/site.ts, which supplies its title and summary. */
  article: string;
  toc: TocEntry[];
}

const { section, article: articleId, toc } = Astro.props;
const { label, href } = sections[section];
const articles: Article[] = sections[section].articles;

const index = articles.findIndex((entry) => entry.id === articleId);
if (index === -1) throw new Error(`No article "${articleId}" under "${section}" in src/data/site.ts`);

const article = articles[index];
const previous = articles[index - 1];
const next = articles[index + 1];
---

<BaseLayout title={`${article.title} — ${SITE_NAME}`} description={article.description} activeSection={section}>
  <MathJax slot="head" />

  <Breadcrumb items={[{ label, href }, { label: article.title }]} />

  <div class="article-grid">
    <nav id="toc" class="toc" aria-label="Table of contents">
      <h2 class="toc-title">Table of contents</h2>
      <ol>
        {toc.map((entry) => <li><a href={`#${entry.id}`}>{entry.label}</a></li>)}
      </ol>
    </nav>

    <article class="prose">
      <header class="article-header">
        <h1>{article.title}</h1>
        <p class="page-subtitle">{article.summary}</p>
      </header>

      <slot />

      {(previous || next) && (
        <nav class="pager" aria-label={`More ${label}`}>
          {previous && (
            <a class="pager-link" href={previous.href}>
              <span class="pager-label">← Previous</span>
              <span class="pager-title">{previous.title}</span>
            </a>
          )}
          {next && (
            <a class="pager-link pager-next" href={next.href}>
              <span class="pager-label">Next →</span>
              <span class="pager-title">{next.title}</span>
            </a>
          )}
        </nav>
      )}
    </article>
  </div>
</BaseLayout>
