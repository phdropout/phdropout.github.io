---
import Breadcrumb from '../components/Breadcrumb.astro';
import MathJax from '../components/MathJax.astro';
import { SITE_NAME, subjects, type SubjectId, type Topic } from '../data/site';
import BaseLayout from './BaseLayout.astro';

interface TocEntry {
  /** Id of the section to jump to, without the leading "#". */
  id: string;
  label: string;
}

interface Props {
  subject: SubjectId;
  /** The topic's id in src/data/site.ts, which supplies its title and summary. */
  topic: string;
  toc: TocEntry[];
}

const { subject, topic: topicId, toc } = Astro.props;
const { label, href } = subjects[subject];
const topics: Topic[] = subjects[subject].topics;

const index = topics.findIndex((entry) => entry.id === topicId);
if (index === -1) throw new Error(`No topic "${topicId}" under "${subject}" in src/data/site.ts`);

const topic = topics[index];
const previous = topics[index - 1];
const next = topics[index + 1];
---

<BaseLayout title={`${topic.tabTitle ?? topic.title} — ${SITE_NAME}`} activeSubject={subject}>
  <MathJax slot="head" />

  <Breadcrumb items={[{ label, href }, { label: topic.title }]} />

  <div class="article-grid">
    <nav id="toc" class="toc" aria-label="Table of contents">
      <h2 class="toc-title">Table of contents</h2>
      <ol>
        {toc.map((entry) => <li><a href={`#${entry.id}`}>{entry.label}</a></li>)}
      </ol>
    </nav>

    <article class="prose">
      <header class="article-header">
        <h1>{topic.title}</h1>
        <p class="page-subtitle">{topic.summary}</p>
      </header>

      <slot />

      {(previous || next) && (
        <nav class="pager" aria-label={`More ${label}`}>
          {previous && (
            <a class="pager-link" href={previous.href}>
              <span class="pager-label">← Previous</span>
              <span class="pager-title">{previous.title}</span>
            </a>
          )}
          {next && (
            <a class="pager-link pager-next" href={next.href}>
              <span class="pager-label">Next →</span>
              <span class="pager-title">{next.title}</span>
            </a>
          )}
        </nav>
      )}
    </article>
  </div>
</BaseLayout>
