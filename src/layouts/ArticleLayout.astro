---
import Breadcrumb from '../components/Breadcrumb.astro';
import MathJax from '../components/MathJax.astro';
import { SITE_NAME, subjects, type SubjectId } from '../data/site';
import BaseLayout from './BaseLayout.astro';

interface TocEntry {
  /** Id of the section to jump to, without the leading "#". */
  id: string;
  label: string;
}

interface Props {
  subject: SubjectId;
  /** Page heading (h1), also used in the breadcrumb. */
  title: string;
  /** Browser tab title, if it should differ from the heading. */
  tabTitle?: string;
  subtitle?: string;
  toc: TocEntry[];
}

const { subject, title, tabTitle = title, subtitle, toc } = Astro.props;
---

<BaseLayout title={`${tabTitle} — ${SITE_NAME}`} activeSubject={subject}>
  <MathJax slot="head" />

  <Breadcrumb items={[subjects[subject], { label: title }]} />

  <section class="page-header">
    <h1>{title}</h1>
    {subtitle && <h2>{subtitle}</h2>}
  </section>

  <section id="toc" class="section-note" aria-label="Table of contents">
    <h2>Table of contents</h2>
    <ol class="bullets" style="margin-top:8px;">
      {toc.map((entry) => <li><a href={`#${entry.id}`}>{entry.label}</a></li>)}
    </ol>
  </section>

  <slot />
</BaseLayout>
