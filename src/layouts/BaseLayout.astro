---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import type { SubjectId } from '../data/site';

interface Props {
  /** Full text of the browser tab title. */
  title: string;
  /** Subject to highlight in the header nav. */
  activeSubject?: SubjectId;
}

const { title, activeSubject } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-WVC02428G3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-WVC02428G3');
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-adsense-account" content="ca-pub-9655733111830298" />
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9655733111830298" crossorigin="anonymous"></script>
    <title>{title}</title>

    <!-- Font (Inter) -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/styles.css" />
    <slot name="head" />
  </head>
  <body class="layout">
    <Header active={activeSubject} />

    <main class="container main-fill">
      <slot />
    </main>

    <Footer />
    <script is:inline src="/script.js"></script>
  </body>
</html>
