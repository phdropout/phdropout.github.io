---
import ConsentBanner from '../components/ConsentBanner.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_NAME, type ActiveNav } from '../data/site';

interface Props {
  /** Full text of the browser tab title. */
  title: string;
  /** Shown under the page's link in search results. */
  description: string;
  /** Menu item to highlight in the header. */
  activeSection?: ActiveNav;
}

const { title, description, activeSection } = Astro.props;

// The one address search engines should use for this page.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!DOCTYPE html>
<html lang="en" data-theme="light">
  <head>
    <!-- Apply the saved theme before anything paints, so dark mode doesn't flash light. -->
    <script is:inline>
      try {
        var savedTheme = localStorage.getItem('theme');
        if (savedTheme) document.documentElement.setAttribute('data-theme', savedTheme);
      } catch (e) {}
    </script>

    <!-- Google Analytics and AdSense only load once the visitor accepts cookies. -->
    <script is:inline>
      window.loadConsentedScripts = function () {
        if (window.consentedScriptsLoaded) return;
        window.consentedScriptsLoaded = true;

        function addScript(src, crossOrigin) {
          var script = document.createElement('script');
          script.async = true;
          script.src = src;
          if (crossOrigin) script.crossOrigin = 'anonymous';
          document.head.appendChild(script);
        }

        // Google tag (gtag.js)
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', 'G-WVC02428G3');
        addScript('https://www.googletagmanager.com/gtag/js?id=G-WVC02428G3');

        // Google AdSense
        addScript('https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9655733111830298', true);
      };

      try {
        if (localStorage.getItem('cookie-consent') === 'accepted') window.loadConsentedScripts();
      } catch (e) {}
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-adsense-account" content="ca-pub-9655733111830298" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- How the page appears when shared -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />

    <!-- Fonts: Inter for interface text, Source Serif 4 for reading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/styles.css" />
    <slot name="head" />
  </head>
  <body class="layout">
    <Header active={activeSection} />

    <main class="container main-fill">
      <slot />
    </main>

    <Footer />
    <ConsentBanner />
    <script is:inline src="/script.js"></script>
  </body>
</html>
