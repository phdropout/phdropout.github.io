---
import { SITE_NAME } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={`${SITE_NAME} — Learn Simply`}>
  <!-- Split hero: bold headline + compact CTAs + slim quick-links card -->
  <section class="hero-split">
    <div class="hero-copy">
      <h1>Welcome to <span class="quiet">Ph.D. Dropout</span> </h1>
      <p class="lede">I always wanted a place devoted to the <i>why</i> behind equations. This project focuses on physics and mathematics derivations presented step by step, with just enough context to stay clear. No fluff—only the reasoning that makes the results inevitable.</p>

      <h2>Why the name</h2>
      <p class="lede">
          The name <i>Ph.D. Dropout</i> comes from the fact that I am a Ph.D. dropout. What stayed is the urge to understand things from first principles. This project is where I turn that habit into notes, derivations, and small practice sets in physics and mathematics.
      </p>


      <div class="hero-actions">
        <a class="btn primary" href="/physics.html">Start Physics</a>
        <a class="btn" href="/maths.html">Start Maths</a>
      </div>
    </div>

    <aside class="hero-card" aria-label="Quick links">
      <h2 class="card-title">Start here</h2>
      <ul class="list-nav">
        <li><a href="/physics-MOD-alg.html">Motion in One Dimension</a></li>
        <li><a href="/maths-trig.html">Trigonometry</a></li>
      </ul>
    </aside>
  </section>

  <!-- Minimal subject pills (replaces big subject cards) -->
  <!--
  <section class="pill-row" aria-label="Subjects">
    <a class="pill" href="physics.html">Physics</a>
    <a class="pill" href="maths.html">Maths</a>
  </section>
  -->
</BaseLayout>
