---
import { SITE_DESCRIPTION, SITE_NAME, sections } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const { topics } = sections;
---

<BaseLayout title={`${SITE_NAME} — Learn Simply`} description={SITE_DESCRIPTION}>
  <section class="hero">
    <div class="hero-copy">
      <h1>Welcome to <span class="quiet">Ph.D. Dropout</span></h1>
      <p class="hero-lede">I always wanted a place devoted to the <i>why</i> behind equations. This project focuses on mathematics derivations presented step by step, with just enough context to stay clear. No fluff—only the reasoning that makes the results inevitable.</p>

      <div class="hero-actions">
        <a class="btn primary" href={topics.href}>Browse Topics</a>
      </div>

      <h2>Why the name</h2>
      <p>
        The name <i>Ph.D. Dropout</i> comes from the fact that I am a Ph.D. dropout. What stayed is the urge to understand things from first principles. This project is where I turn that habit into notes, derivations, and small practice sets in mathematics. <a class="story-link" href="/about/">Read my story →</a>
      </p>
    </div>

    <aside class="start-here" aria-label="Quick links">
      <h2 class="start-title">Start here</h2>
      <ul>
        {topics.articles.map((article) => (
          <li><a href={article.href}>{article.title}<span aria-hidden="true">→</span></a></li>
        ))}
      </ul>
    </aside>
  </section>
</BaseLayout>
