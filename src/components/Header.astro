---
import { SITE_NAME, subjects, type SubjectId } from '../data/site';

interface Props {
  /** Subject to highlight in the nav. */
  active?: SubjectId;
}

const { active } = Astro.props;
---

<header class="site-header">
  <div class="container header-wrap">
    <a href="/" class="brand" aria-label={`${SITE_NAME} — Home`}>
      <span class="brand-mark"><img src="/logo/logo.svg" alt="" /></span>
      <span class="brand-text">{SITE_NAME}</span>
    </a>

    <nav class="nav" aria-label="Subjects">
      {Object.entries(subjects).map(([id, subject]) => (
        <a class={id === active ? 'active' : undefined} href={subject.href} aria-current={id === active ? 'true' : undefined}>{subject.label}</a>
      ))}
      <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle light/dark">
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" /></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg>
      </button>
    </nav>
  </div>
</header>
